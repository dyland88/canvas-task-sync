// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "sqlite"
    url      = env("DATABASE_URL")
}

model User {
    id              String           @id @default(cuid())
    email           String           @unique
    name            String?
    googleId        String           @unique
    accessToken     String // Google OAuth access token
    refreshToken    String // Google OAuth refresh token
    tokenExpiry     DateTime?
    createdAt       DateTime         @default(now())
    updatedAt       DateTime         @updatedAt
    
    canvasIntegrations CanvasIntegration[]
    syncLogs           SyncLog[]
    
    @@index([email])
    @@index([googleId])
}

model CanvasIntegration {
    id              String   @id @default(cuid())
    userId          String
    canvasUrl       String   // Canvas calendar feed URL
    taskListId      String   // Google Task List ID
    taskListName    String   // Google Task List Name for display
    isActive        Boolean  @default(true)
    lastSyncAt      DateTime?
    createdAt       DateTime @default(now())
    updatedAt       DateTime @updatedAt
    
    user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    syncedTasks     SyncedTask[]
    
    @@index([userId])
    @@index([lastSyncAt])
}

model SyncedTask {
    id                  String            @id @default(cuid())
    canvasIntegrationId String
    canvasEventId       String            // Unique ID from Canvas calendar event
    googleTaskId        String            // Google Task ID
    title               String
    description         String?
    dueDate             DateTime?
    course              String?
    status              String            @default("needsAction") // needsAction, completed
    createdAt           DateTime          @default(now())
    updatedAt           DateTime          @updatedAt
    
    canvasIntegration   CanvasIntegration @relation(fields: [canvasIntegrationId], references: [id], onDelete: Cascade)
    
    @@unique([canvasIntegrationId, canvasEventId])
    @@index([canvasIntegrationId])
    @@index([dueDate])
}

model SyncLog {
    id              String   @id @default(cuid())
    userId          String
    integrationId   String?
    status          String   // success, error, partial
    message         String?
    tasksProcessed  Int      @default(0)
    tasksCreated    Int      @default(0)
    tasksUpdated    Int      @default(0)
    tasksSkipped    Int      @default(0)
    errors          String?  // JSON string of error details
    createdAt       DateTime @default(now())
    
    user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    
    @@index([userId])
    @@index([createdAt])
    @@index([status])
}

// Keep the original Post model for now (can be removed later)
model Post {
    id        Int      @id @default(autoincrement())
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([name])
}
